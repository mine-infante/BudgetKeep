// ==========================================================
// BudgetKeep
// Entity Relationship Diagram (ERD)
// Level 1 - Logical Data Model
//
// Domains:
// Identity & Security + Catalogs + Financial Resources
// + Financial Events + Financial Planning
// ==========================================================

// ==========================================================
// Identity & Security
// ==========================================================

Table User {
  UserId bigint [pk]
  SupportId varchar [not null, unique]
  Username varchar [not null, unique]
  Email varchar [not null, unique]
  FirstName varchar [not null]
  LastName varchar [not null]
  PhoneNumber varchar [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table UserSecurity {
  UserId bigint [pk]
  PasswordHash varchar [not null]
  FailedLoginAttempts int [not null]
  LockoutUntil datetime
  LockoutCount int [not null]
  LockoutWindowStart datetime
  LastLoginDate datetime
  PasswordChangedDate datetime
  RequiresSupport boolean [not null]
}

Table Role {
  RoleId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsSystemRole boolean [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table Module {
  ModuleId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table Permission {
  PermissionId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table ModulePermission {
  ModuleId bigint [pk]
  PermissionId bigint [pk]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table UserRole {
  UserId bigint [pk]
  RoleId bigint [pk]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table RolePermission {
  RoleId bigint [pk]
  ModuleId bigint [pk]
  PermissionId bigint [pk]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table UserPreference {
  UserId bigint [pk]
  PreferredLanguageId bigint [not null]
  TimeZoneId bigint [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table Language {
  LanguageId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table TimeZone {
  TimeZoneId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

// ==========================================================
// Catalogs
// ==========================================================

Table Currency {
  CurrencyId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Symbol varchar [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table IncomeType {
  IncomeTypeId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table ExpenseCategory {
  ExpenseCategoryId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table RecurrenceType {
  RecurrenceTypeId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

// ==========================================================
// Financial Resources
// ==========================================================

Table FinancialResource {
  FinancialResourceId bigint [pk]
  UserId bigint [not null]
  Name varchar [not null]
  ResourceType varchar [not null]
  CurrencyId bigint [not null]
  AvailableAmount decimal [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

// ==========================================================
// System Configuration
// ==========================================================

Table SystemConfiguration {
  SystemConfigurationId bigint [pk]
  Code varchar [not null, unique]
  Value varchar [not null]
  ConfigurationDataTypeId bigint [not null]
  Description varchar [not null]
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table ConfigurationDataType {
  ConfigurationDataTypeId bigint [pk]
  Code varchar [not null, unique]
  Name varchar [not null]
  Description varchar
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

// ==========================================================
// Financial Events
// ==========================================================

Table Income {
  IncomeId bigint [pk]
  UserId bigint [not null]
  Name varchar [not null]
  IncomeTypeId bigint [not null]
  CurrencyId bigint [not null]
  ExpectedAmount decimal
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table Expense {
  ExpenseId bigint [pk]
  UserId bigint [not null]
  Name varchar [not null]
  ExpenseCategoryId bigint [not null]
  ExpenseType varchar [not null]
  CurrencyId bigint [not null]
  ExpectedAmount decimal
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table StandAlone {
  StandAloneId bigint [pk]
  UserId bigint [not null]
  EventType varchar [not null]
  Description varchar [not null]
  CurrencyId bigint [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table FinancialEvent {
  FinancialEventId bigint [pk]
  UserId bigint [not null]
  EventType varchar [not null]
  IncomeId bigint
  ExpenseId bigint
  StandAloneId bigint
  ExpectedDate date [not null]
  ActualDate date
  ExpectedAmount decimal
  ActualAmount decimal
  EventStatus varchar [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table RecurrenceConfiguration {
  RecurrenceConfigurationId bigint [pk]
  IncomeId bigint
  ExpenseId bigint
  RecurrenceTypeId bigint [not null]
  StartDate date [not null]
  EndDate date
  DayOfMonth int
  DayOfWeek int
  AnchorDate date
  IsActive boolean [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

// ==========================================================
// Financial Planning
// ==========================================================

Table FinancialStrategy {
  FinancialStrategyId bigint [pk]
  UserId bigint [not null]
  Name varchar [not null]
  Objective varchar [not null]
  Description varchar [not null]
  RecommendedPriority int
  ExpectedBenefits varchar
  Considerations varchar
  CreatedAt datetime [not null]
  CreatedBy bigint
}

Table FinancialStrategyItem {
  FinancialStrategyItemId bigint [pk]
  FinancialStrategyId bigint [not null]
  SequenceNumber int [not null]
  Description varchar [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
}

Table FinancialPlan {
  FinancialPlanId bigint [pk]
  UserId bigint [not null]
  Name varchar [not null]
  Objective varchar [not null]
  StartDate date [not null]
  ReviewDate date
  LifecycleStatus varchar [not null]
  UserNotes varchar
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
}

Table FinancialPlanItem {
  FinancialPlanItemId bigint [pk]
  FinancialPlanId bigint [not null]
  SequenceNumber int [not null]
  Description varchar [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint
  UpdatedAt datetime
  UpdatedBy bigint
  DeletedAt datetime
  DeletedBy bigint
}

Table FinancialPlanStrategy {
  FinancialPlanId bigint [not null]
  FinancialStrategyId bigint [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint

  indexes {
    (FinancialPlanId, FinancialStrategyId) [pk]
  }
}

Table FinancialPlanResource {
  FinancialPlanId bigint [not null]
  FinancialResourceId bigint [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint

  indexes {
    (FinancialPlanId, FinancialResourceId) [pk]
  }
}

Table FinancialPlanItemEvent {
  FinancialPlanItemId bigint [not null]
  FinancialEventId bigint [not null]
  CreatedAt datetime [not null]
  CreatedBy bigint

  indexes {
    (FinancialPlanItemId, FinancialEventId) [pk]
  }
}

// ==========================================================
// Relaciones funcionales
// ==========================================================

// Identity & Security
Ref: UserSecurity.UserId - User.UserId

Ref: UserPreference.UserId - User.UserId
Ref: UserPreference.PreferredLanguageId > Language.LanguageId
Ref: UserPreference.TimeZoneId > TimeZone.TimeZoneId

Ref: UserRole.UserId > User.UserId
Ref: UserRole.RoleId > Role.RoleId

Ref: ModulePermission.ModuleId > Module.ModuleId
Ref: ModulePermission.PermissionId > Permission.PermissionId

Ref: RolePermission.RoleId > Role.RoleId
Ref: RolePermission.(ModuleId, PermissionId) > ModulePermission.(ModuleId, PermissionId)

// System Configuration
Ref: SystemConfiguration.ConfigurationDataTypeId > ConfigurationDataType.ConfigurationDataTypeId

// Financial Resources
Ref: FinancialResource.UserId > User.UserId
Ref: FinancialResource.CurrencyId > Currency.CurrencyId

// Financial Events — source definitions
Ref: Income.UserId > User.UserId
Ref: Income.IncomeTypeId > IncomeType.IncomeTypeId
Ref: Income.CurrencyId > Currency.CurrencyId

Ref: Expense.UserId > User.UserId
Ref: Expense.ExpenseCategoryId > ExpenseCategory.ExpenseCategoryId
Ref: Expense.CurrencyId > Currency.CurrencyId

Ref: StandAlone.UserId > User.UserId
Ref: StandAlone.CurrencyId > Currency.CurrencyId

// Financial Events — occurrences
Ref: FinancialEvent.UserId > User.UserId
Ref: FinancialEvent.IncomeId > Income.IncomeId
Ref: FinancialEvent.ExpenseId > Expense.ExpenseId
Ref: FinancialEvent.StandAloneId > StandAlone.StandAloneId

// Financial Events — recurrence
Ref: RecurrenceConfiguration.IncomeId > Income.IncomeId
Ref: RecurrenceConfiguration.ExpenseId > Expense.ExpenseId
Ref: RecurrenceConfiguration.RecurrenceTypeId > RecurrenceType.RecurrenceTypeId

// ==========================================================
// Reglas del modelo que no se expresan completamente mediante
// las relaciones DBML
// ==========================================================
//
// FinancialEvent source XOR:
// exactly one of IncomeId, ExpenseId, StandAloneId must be populated.
//
// Income -> FinancialEvent: 1:N
// Expense -> FinancialEvent: 1:N
// StandAlone -> FinancialEvent: 1:N
//
// Income -> RecurrenceConfiguration: 1:0..1
// Expense -> RecurrenceConfiguration: 1:0..1
//
// StandAlone does NOT have RecurrenceConfiguration.
// A StandAlone may be reused as the source of multiple FinancialEvents.
// It does not automatically generate recurring events.
//
// FinancialEvent.Expected* represents the expected state.
// FinancialEvent.Actual* represents the user-confirmed reality.
//
// ==========================================================
// Relaciones técnicas de auditoría
// ==========================================================

Ref: User.CreatedBy > User.UserId
Ref: User.UpdatedBy > User.UserId
Ref: User.DeletedBy > User.UserId

Ref: Role.CreatedBy > User.UserId
Ref: Role.UpdatedBy > User.UserId
Ref: Role.DeletedBy > User.UserId

Ref: Module.CreatedBy > User.UserId
Ref: Module.UpdatedBy > User.UserId
Ref: Module.DeletedBy > User.UserId

Ref: Permission.CreatedBy > User.UserId
Ref: Permission.UpdatedBy > User.UserId
Ref: Permission.DeletedBy > User.UserId

Ref: ModulePermission.CreatedBy > User.UserId
Ref: ModulePermission.UpdatedBy > User.UserId
Ref: ModulePermission.DeletedBy > User.UserId

Ref: UserRole.CreatedBy > User.UserId
Ref: UserRole.UpdatedBy > User.UserId

Ref: RolePermission.CreatedBy > User.UserId
Ref: RolePermission.UpdatedBy > User.UserId

Ref: UserPreference.CreatedBy > User.UserId
Ref: UserPreference.UpdatedBy > User.UserId

Ref: Language.CreatedBy > User.UserId
Ref: Language.UpdatedBy > User.UserId

Ref: TimeZone.CreatedBy > User.UserId
Ref: TimeZone.UpdatedBy > User.UserId

Ref: Currency.CreatedBy > User.UserId
Ref: Currency.UpdatedBy > User.UserId

Ref: IncomeType.CreatedBy > User.UserId
Ref: IncomeType.UpdatedBy > User.UserId
Ref: IncomeType.DeletedBy > User.UserId

Ref: ExpenseCategory.CreatedBy > User.UserId
Ref: ExpenseCategory.UpdatedBy > User.UserId
Ref: ExpenseCategory.DeletedBy > User.UserId

Ref: RecurrenceType.CreatedBy > User.UserId
Ref: RecurrenceType.UpdatedBy > User.UserId

Ref: SystemConfiguration.CreatedBy > User.UserId
Ref: SystemConfiguration.UpdatedBy > User.UserId

Ref: ConfigurationDataType.CreatedBy > User.UserId
Ref: ConfigurationDataType.UpdatedBy > User.UserId

Ref: FinancialResource.CreatedBy > User.UserId
Ref: FinancialResource.UpdatedBy > User.UserId
Ref: FinancialResource.DeletedBy > User.UserId

Ref: Income.CreatedBy > User.UserId
Ref: Income.UpdatedBy > User.UserId
Ref: Income.DeletedBy > User.UserId

Ref: Expense.CreatedBy > User.UserId
Ref: Expense.UpdatedBy > User.UserId
Ref: Expense.DeletedBy > User.UserId

Ref: StandAlone.CreatedBy > User.UserId
Ref: StandAlone.UpdatedBy > User.UserId
Ref: StandAlone.DeletedBy > User.UserId

Ref: FinancialEvent.CreatedBy > User.UserId
Ref: FinancialEvent.UpdatedBy > User.UserId
Ref: FinancialEvent.DeletedBy > User.UserId

Ref: RecurrenceConfiguration.CreatedBy > User.UserId
Ref: RecurrenceConfiguration.UpdatedBy > User.UserId
Ref: RecurrenceConfiguration.DeletedBy > User.UserId

// ==========================================================
// Financial Planning
// ==========================================================

Ref: FinancialStrategy.UserId > User.UserId
Ref: FinancialStrategy.CreatedBy > User.UserId

Ref: FinancialStrategyItem.FinancialStrategyId > FinancialStrategy.FinancialStrategyId
Ref: FinancialStrategyItem.CreatedBy > User.UserId

Ref: FinancialPlan.UserId > User.UserId
Ref: FinancialPlan.CreatedBy > User.UserId
Ref: FinancialPlan.UpdatedBy > User.UserId

Ref: FinancialPlanItem.FinancialPlanId > FinancialPlan.FinancialPlanId
Ref: FinancialPlanItem.CreatedBy > User.UserId
Ref: FinancialPlanItem.UpdatedBy > User.UserId
Ref: FinancialPlanItem.DeletedBy > User.UserId

Ref: FinancialPlanStrategy.FinancialPlanId > FinancialPlan.FinancialPlanId
Ref: FinancialPlanStrategy.FinancialStrategyId > FinancialStrategy.FinancialStrategyId
Ref: FinancialPlanStrategy.CreatedBy > User.UserId

Ref: FinancialPlanResource.FinancialPlanId > FinancialPlan.FinancialPlanId
Ref: FinancialPlanResource.FinancialResourceId > FinancialResource.FinancialResourceId
Ref: FinancialPlanResource.CreatedBy > User.UserId

Ref: FinancialPlanItemEvent.FinancialPlanItemId > FinancialPlanItem.FinancialPlanItemId
Ref: FinancialPlanItemEvent.FinancialEventId > FinancialEvent.FinancialEventId
Ref: FinancialPlanItemEvent.CreatedBy > User.UserId